-- Función para añadir botones interactivos con el sub-botón de ejecución
local function AddScriptButton(name, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, 0, 0, 36)
    Container.BackgroundTransparency = 1
    Container.ClipsDescendants = true
    Container.Parent = ContentFrame

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 36)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
    Btn.BackgroundTransparency = 0.3
    Btn.Font = Enum.Font.Code
    Btn.Text = name
    Btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    Btn.TextSize = 13
    Btn.Parent = Container

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(255, 255, 255)
    BtnStroke.Thickness = 1
    BtnStroke.Transparency = 0.6
    BtnStroke.Parent = Btn

    local ExecBtn = Instance.new("TextButton")
    ExecBtn.Size = UDim2.new(1, 0, 0, 32)
    ExecBtn.Position = UDim2.new(0, 0, 0, 40)
    ExecBtn.BackgroundColor3 = Color3.fromRGB(30, 120, 60)
    ExecBtn.BackgroundTransparency = 0.2
    ExecBtn.Font = Enum.Font.Code
    ExecBtn.Text = "ejecutar >_"
    ExecBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ExecBtn.TextSize = 12
    ExecBtn.Parent = Container

    local ExecCorner = Instance.new("UICorner")
    ExecCorner.CornerRadius = UDim.new(0, 6)
    ExecCorner.Parent = ExecBtn

    local ExecStroke = Instance.new("UIStroke")
    ExecStroke.Color = Color3.fromRGB(150, 255, 180)
    ExecStroke.Thickness = 1
    ExecStroke.Transparency = 0.4
    ExecStroke.Parent = ExecBtn

    Btn.MouseEnter:Connect(function()
        if selectedContainer ~= Container then
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(65, 65, 85)}):Play()
        end
    end)

    Btn.MouseLeave:Connect(function()
        if selectedContainer ~= Container then
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 58)}):Play()
        end
    end)

    Btn.MouseButton1Click:Connect(function()
        local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        if selectedContainer and selectedContainer ~= Container then
            local prevBtn = selectedContainer:FindFirstChildOfClass("TextButton")
            TweenService:Create(selectedContainer, tweenInfo, {Size = UDim2.new(1, 0, 0, 36)}):Play()
            if prevBtn then
                TweenService:Create(prevBtn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(45, 45, 58)}):Play()
            end
        end

        if selectedContainer == Container then
            TweenService:Create(Container, tweenInfo, {Size = UDim2.new(1, 0, 0, 36)}):Play()
            TweenService:Create(Btn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(45, 45, 58)}):Play()
            selectedContainer = nil
        else
            TweenService:Create(Container, tweenInfo, {Size = UDim2.new(1, 0, 0, 78)}):Play()
            TweenService:Create(Btn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(60, 60, 80)}):Play()
            selectedContainer = Container
        end
    end)

    ExecBtn.MouseButton1Click:Connect(function()
        pcall(callback)
    end)
end

