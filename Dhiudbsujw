local minimized = false
local originalSize = MainFrame.Size

MinimizeButton.MouseButton1Click:Connect(function()
    minimized = not minimized
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    
    if minimized then
        ContentFrame.Visible = false
        TopBarFix.Visible = false
        
        MainCorner.CornerRadius = UDim.new(1, 0)
        TopBarCorner.CornerRadius = UDim.new(1, 0)
        
        TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 350, 0, 45)}):Play()
        MinimizeButton.Text = "+"
    else
        MainFrame.Visible = true
        TweenService:Create(MainFrame, tweenInfo, {Size = originalSize}):Play()
        
        MainCorner.CornerRadius = UDim.new(0, 10)
        TopBarCorner.CornerRadius = UDim.new(0, 10)
        
        TopBarFix.Visible = true
        ContentFrame.Visible = true
        MinimizeButton.Text = "-"
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    if aimbotConnection then
        aimbotConnection:Disconnect()
    end
    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local closeTween = TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})
    closeTween:Play()
    closeTween.Completed:Connect(function()
        ScreenGui:Destroy()
    end)
end)
